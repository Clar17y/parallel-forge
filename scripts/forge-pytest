#!/bin/sh
set -eu

status=0
for input in pyproject.toml uv.lock; do
    if [ ! -f "$input" ] || ! cmp -s "/opt/forge-checks-inputs/$input" "$input"; then
        printf 'forge-pytest requires a worktree %s matching the runner image.\n' "$input" >&2
        status=2
    fi
done
if [ "$status" -ne 0 ]; then
    echo 'Restore the matching inputs or rebuild the forge-checks target from this worktree.' >&2
    exit "$status"
fi

export PYTHONPATH=/workspace/apps/orchestrator/src
export PYTHONDONTWRITEBYTECODE="${PYTHONDONTWRITEBYTECODE:-1}"
exec /opt/forge-checks-venv/bin/python -m pytest "$@"
