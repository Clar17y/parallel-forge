# Local PostgreSQL and service configuration
FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@127.0.0.1:5435/forge
FORGE_DATA_ROOT=
FORGE_BIND_HOST=127.0.0.1
FORGE_API_PORT=8000
FORGE_WEB_ORIGIN=http://127.0.0.1:3000
# Next server only: fixed loopback API destination, never exposed to browser code.
FORGE_API_INTERNAL_ORIGIN=http://127.0.0.1:8000
FORGE_RUNNER_IMAGE=
# Whole subscription-run primary budget, frozen when initial planning starts.
# Other TaskBudget limits keep their defaults; this does not authorize paid mode.
FORGE_SUBSCRIPTION_PRIMARY_BUDGET={"max_provider_attempts":64}
# Local invocation slots; durable scheduler capacity still applies across processes.
FORGE_SUBSCRIPTION_WORKER_CONCURRENCY=3
# Per-attempt ceiling, clipped to the remaining frozen task/run budgets.
# No repair unit is charged for admission or an ineligible route.
FORGE_SUBSCRIPTION_ATTEMPT_BUDGET={"max_duration_seconds":300,"max_tool_calls":25,"max_named_checks":2,"max_provider_attempts":1,"max_repairs":0}
# Optional absolute path to the closed, versioned subscription installation manifest.
# The file references existing official-client homes; Forge never copies credential caches.
FORGE_SUBSCRIPTION_INSTALLATIONS_PATH=

# Secret references only; resolve secret values outside the repository.
FORGE_PROVIDER_SECRET_REFERENCE=
FORGE_GOOGLE_API_KEY_REFERENCE=
FORGE_GITHUB_TOKEN_REFERENCE=

# Non-secret account/pool labels shared by API, worker and CLI. Defaults group
# each provider's local account across models within one auth/billing mode. Exact
# mappings in the installation manifest are merged into this policy in every process.
# Expiry permits one probe; this is not remaining allowance or a known reset.
# FORGE_SUBSCRIPTION_QUOTA_POLICY={"unknown_reset_cooldown_seconds":3600,"route_pools":[{"provider":"anthropic","client":"claude_code","account":"local","pool":"weekly"}]}

# Advisory search ranking (default off). "shadow" measures a ranking without
# changing what agents receive; "on" also collapses the low-relevance tail.
# Both require TYPESAFE_API_KEY in the process environment and degrade to "off"
# without it. Enabling either sends bounded, redacted repository match text and
# the task description to TypeSafe; leave off to keep search fully local.
FORGE_SEARCH_RANKING_MODE=off
FORGE_SEARCH_RANKING_TOP_K=15
FORGE_SEARCH_RANKING_MODEL=jev-latest
# Not a FORGE_ setting: read straight from the environment and never persisted.
# TYPESAFE_API_KEY=
